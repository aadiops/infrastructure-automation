from app.app import app


def test_healthz():
    client = app.test_client()
    response = client.get('/healthz')
    assert response.status_code == 200
    assert 'status' in response.get_json()


def test_index():
    client = app.test_client()
    response = client.get('/')
    assert response.status_code == 200
    assert response.get_json()['service'] == 'infrastructure-automation'
